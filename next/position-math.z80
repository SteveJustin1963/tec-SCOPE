; ============================================================================
; Position Calculation to 3 Decimal Places
; Converts pulse counts to degrees with high precision
; ============================================================================
;
; LIBRARY CODE - NOT STANDALONE
; ============================================================================
; This file contains REFERENCE CODE for position calculations.
; Copy the routines you need into your main program.
;
; Main Routines:
;   COUNT_TO_DEGREES_3DP - Convert count to degrees (3 decimal places)
;   DEGREES_TO_COUNT     - Convert degrees to count
;   DIV_16BIT            - 16-bit division helper
;
; Usage in Main Program:
;   1. Include this file or copy routines into your program
;   2. Define RAM variables (DEGREES_INT, DEGREES_DEC)
;   3. Call COUNT_TO_DEGREES_3DP with count in HL
;   4. Result in DEGREES_INT (integer) and DEGREES_DEC (decimal)
;
; WIRING - Not applicable (math library, no hardware)
; ============================================================================
; With 8 slots × 100:1 gearing = 800 counts per 360°
; Resolution: 360 / 800 = 0.45° per count
;
; This code calculates position to 3 decimal places (e.g., 123.456°)
; even though physical resolution is only 0.45°
;
; Example Integration with optical-gate-control.z80:
;   ; In your main program after reading sensors:
;   LD      HL, (POS_X_LO)          ; Get current position
;   CALL    COUNT_TO_DEGREES_3DP    ; Convert to degrees
;   ; Now display DEGREES_INT and DEGREES_DEC
;
; ============================================================================

        ORG     0800h

; ============================================================================
; Constants for 8 slots × 100:1 gearing
; ============================================================================
COUNTS_PER_REV: EQU     800     ; 8 slots × 100:1 = 800 counts/360°

; ============================================================================
; COUNT_TO_DEGREES_3DP - Convert count to degrees with 3 decimal places
;
; Input:  HL = count (0-799 for one revolution)
; Output: Degrees stored in memory as:
;         Integer part (0-359) at DEGREES_INT
;         Decimal part (000-999) at DEGREES_DEC
;
; Formula: degrees = (count × 360) / 800
;                  = (count × 360000) / 800000  (for 3 decimal places)
;                  = (count × 45) / 100
;
; Example: count = 100
;          degrees = (100 × 360) / 800 = 36000 / 800 = 45.000°
; ============================================================================
COUNT_TO_DEGREES_3DP:
        ; Save count
        PUSH    HL

        ; Multiply count by 45 (gives result in 0.01° units)
        ; count × 45 = count × 32 + count × 8 + count × 4 + count × 1

        LD      D, H
        LD      E, L            ; DE = count (save original)

        ; HL = count × 32
        ADD     HL, HL          ; × 2
        ADD     HL, HL          ; × 4
        ADD     HL, HL          ; × 8
        ADD     HL, HL          ; × 16
        ADD     HL, HL          ; × 32

        PUSH    HL              ; Save count × 32

        ; HL = count × 8
        LD      H, D
        LD      L, E            ; Restore count
        ADD     HL, HL          ; × 2
        ADD     HL, HL          ; × 4
        ADD     HL, HL          ; × 8

        LD      B, H
        LD      C, L            ; BC = count × 8

        POP     HL              ; HL = count × 32
        ADD     HL, BC          ; HL = count × 40

        ; Now add count × 4
        LD      H, D
        LD      L, E
        ADD     HL, HL
        ADD     HL, HL          ; HL = count × 4

        LD      B, H
        LD      C, L

        POP     HL              ; Get count × 40
        PUSH    HL
        ADD     HL, BC          ; HL = count × 44

        ; Add count × 1
        LD      B, D
        LD      C, E
        ADD     HL, BC          ; HL = count × 45

        ; Now HL contains count × 45 (in 0.01° units)
        ; Need to divide by 100 to get degrees.hundredths

        CALL    DIV_BY_100      ; HL = degrees × 100 (e.g., 4500 = 45.00°)

        ; Extract integer degrees (divide by 100)
        LD      DE, 100
        CALL    DIV_16BIT       ; HL = integer degrees, DE = remainder

        LD      A, L
        LD      (DEGREES_INT), A        ; Store integer part

        ; Remainder in DE is the hundredths
        ; Multiply by 10 to get thousandths
        LD      H, D
        LD      L, E
        ADD     HL, HL          ; × 2
        LD      B, H
        LD      C, L
        ADD     HL, HL          ; × 4
        ADD     HL, HL          ; × 8
        ADD     HL, BC          ; × 10

        LD      (DEGREES_DEC), HL       ; Store decimal part (000-999)

        RET

; ============================================================================
; SIMPLER VERSION: Direct calculation for display
; Input:  HL = count
; Output: Display "XXX.XXX" on 7-segment or serial
; ============================================================================
DISPLAY_POSITION:
        CALL    COUNT_TO_DEGREES_3DP

        ; Integer part in DEGREES_INT
        LD      A, (DEGREES_INT)
        CALL    DISPLAY_DECIMAL         ; Display "123"

        ; Display decimal point
        LD      A, '.'
        CALL    DISPLAY_CHAR

        ; Decimal part in DEGREES_DEC
        LD      HL, (DEGREES_DEC)

        ; Display hundreds digit
        LD      DE, 100
        CALL    DIV_16BIT
        LD      A, L
        ADD     A, '0'
        CALL    DISPLAY_CHAR

        ; Display tens digit
        LD      H, D
        LD      L, E            ; Remainder
        LD      DE, 10
        CALL    DIV_16BIT
        LD      A, L
        ADD     A, '0'
        CALL    DISPLAY_CHAR

        ; Display units digit
        LD      A, E
        ADD     A, '0'
        CALL    DISPLAY_CHAR

        RET

; ============================================================================
; EXAMPLE: Calculate all common positions
; ============================================================================
TEST_POSITIONS:
        ; Test position 1: 0 counts = 0.000°
        LD      HL, 0
        CALL    COUNT_TO_DEGREES_3DP
        ; Result: DEGREES_INT = 0, DEGREES_DEC = 0

        ; Test position 2: 100 counts = 45.000°
        LD      HL, 100
        CALL    COUNT_TO_DEGREES_3DP
        ; Result: DEGREES_INT = 45, DEGREES_DEC = 0

        ; Test position 3: 222 counts = 99.900° (approx)
        ; (222 × 360) / 800 = 79920 / 800 = 99.9°
        LD      HL, 222
        CALL    COUNT_TO_DEGREES_3DP
        ; Result: DEGREES_INT = 99, DEGREES_DEC = 900

        ; Test position 4: 400 counts = 180.000° (half rotation)
        LD      HL, 400
        CALL    COUNT_TO_DEGREES_3DP
        ; Result: DEGREES_INT = 180, DEGREES_DEC = 0

        ; Test position 5: 800 counts = 360.000° (full rotation)
        LD      HL, 800
        CALL    COUNT_TO_DEGREES_3DP
        ; Result: DEGREES_INT = 360, DEGREES_DEC = 0

        RET

; ============================================================================
; REVERSE: Convert degrees to counts
; Input: Degrees integer at DEGREES_INT, decimal at DEGREES_DEC
; Output: HL = count
; Formula: count = (degrees × 800) / 360 = degrees × 2.222...
; ============================================================================
DEGREES_TO_COUNT:
        ; Get integer degrees
        LD      A, (DEGREES_INT)
        LD      L, A
        LD      H, 0            ; HL = integer degrees

        ; Multiply by 800
        ; degrees × 800 = degrees × 512 + degrees × 256 + degrees × 32
        PUSH    HL              ; Save degrees

        ; HL × 512
        ADD     HL, HL          ; × 2
        ADD     HL, HL          ; × 4
        ADD     HL, HL          ; × 8
        ADD     HL, HL          ; × 16
        ADD     HL, HL          ; × 32
        ADD     HL, HL          ; × 64
        ADD     HL, HL          ; × 128
        ADD     HL, HL          ; × 256
        ADD     HL, HL          ; × 512

        PUSH    HL              ; Save × 512

        POP     BC              ; BC = × 512
        POP     HL              ; HL = degrees

        ; degrees × 256
        PUSH    BC
        ADD     HL, HL          ; × 2
        ADD     HL, HL          ; × 4
        ADD     HL, HL          ; × 8
        ADD     HL, HL          ; × 16
        ADD     HL, HL          ; × 32
        ADD     HL, HL          ; × 64
        ADD     HL, HL          ; × 128
        ADD     HL, HL          ; × 256

        POP     BC
        ADD     HL, BC          ; HL = degrees × 768

        ; Add degrees × 32 (need original again)
        LD      A, (DEGREES_INT)
        LD      C, A
        LD      B, 0
        PUSH    HL
        LD      H, B
        LD      L, C
        ADD     HL, HL          ; × 2
        ADD     HL, HL          ; × 4
        ADD     HL, HL          ; × 8
        ADD     HL, HL          ; × 16
        ADD     HL, HL          ; × 32
        LD      B, H
        LD      C, L
        POP     HL
        ADD     HL, BC          ; HL = degrees × 800

        ; Divide by 360
        LD      DE, 360
        CALL    DIV_16BIT       ; HL = count, DE = remainder

        RET

; ============================================================================
; Helper: 16-bit division
; Input: HL = dividend, DE = divisor
; Output: HL = quotient, DE = remainder
; ============================================================================
DIV_16BIT:
        LD      BC, 0           ; BC = quotient

DIV_LOOP:
        ; Check if HL < DE
        LD      A, H
        CP      D
        JR      C, DIV_DONE     ; H < D
        JR      NZ, DIV_SUB     ; H > D
        LD      A, L
        CP      E
        JR      C, DIV_DONE     ; L < E

DIV_SUB:
        ; HL = HL - DE
        OR      A               ; Clear carry
        SBC     HL, DE
        INC     BC              ; Increment quotient
        JR      DIV_LOOP

DIV_DONE:
        ; HL = remainder, BC = quotient
        PUSH    HL
        LD      H, B
        LD      L, C            ; HL = quotient
        POP     DE              ; DE = remainder
        RET

; ============================================================================
; Helper: Divide by 100
; Input: HL = value
; Output: HL = value / 100, DE = remainder
; ============================================================================
DIV_BY_100:
        LD      DE, 100
        CALL    DIV_16BIT
        RET

; ============================================================================
; Placeholder display functions (implement for your hardware)
; ============================================================================
DISPLAY_DECIMAL:
        ; Display 8-bit decimal number in A
        ; TODO: Implement for TEC-1 7-segment or serial
        RET

DISPLAY_CHAR:
        ; Display single character in A
        ; TODO: Implement for serial port or display
        RET

; ============================================================================
; RAM variables
; ============================================================================
        ORG     0900h

DEGREES_INT:    DS      1       ; Integer part (0-359)
DEGREES_DEC:    DS      2       ; Decimal part (000-999)

; ============================================================================
; LOOKUP TABLE METHOD (Faster but uses more memory)
; Pre-calculated degrees for each count (0-799)
; ============================================================================
        ORG     0A00h

; Table: degrees × 1000 for each count
; Entry N: (N × 360000) / 800 = N × 450
; This gives degrees in thousandths
;
; Example entries:
; Count 0: 0 × 450 = 0 → 0.000°
; Count 1: 1 × 450 = 450 → 0.450°
; Count 2: 2 × 450 = 900 → 0.900°
; Count 3: 3 × 450 = 1350 → 1.350°
; Count 100: 100 × 450 = 45000 → 45.000°
; Count 800: 800 × 450 = 360000 → 360.000°

; To use lookup table:
LOOKUP_DEGREES:
        ; Input: HL = count (0-799)
        ; Multiply count by 450
        ; Then divide by 1000 to get degrees.decimals

        ; HL × 450 = HL × 256 + HL × 128 + HL × 64 + HL × 2
        LD      D, H
        LD      E, L            ; Save count

        ; × 256
        LD      B, L
        LD      C, 0            ; BC = count × 256

        ; × 128
        LD      H, 0
        LD      L, E
        ADD     HL, HL
        ADD     HL, HL
        ADD     HL, HL
        ADD     HL, HL
        ADD     HL, HL
        ADD     HL, HL
        ADD     HL, HL          ; HL = count × 128

        ADD     HL, BC          ; HL = count × 384

        ; × 64
        LD      H, 0
        LD      L, E
        ADD     HL, HL
        ADD     HL, HL
        ADD     HL, HL
        ADD     HL, HL
        ADD     HL, HL
        ADD     HL, HL          ; HL = count × 64

        LD      B, H
        LD      C, L
        ; Add to running total (need to get it back)
        ; This is getting complex - the calculation method above is better!

        RET

; ============================================================================
; PRACTICAL EXAMPLE: Display Alt/Az positions
; ============================================================================
DISPLAY_TELESCOPE_POSITION:
        ; Read Alt position counter
        LD      HL, (POS_X_LO)  ; Defined in main code at 0904h
        CALL    COUNT_TO_DEGREES_3DP

        ; Display "Alt: XXX.XXX°"
        ; ... send to display or serial ...

        ; Read Az position counter
        LD      HL, (POS_Y_LO)  ; Defined in main code at 0906h
        CALL    COUNT_TO_DEGREES_3DP

        ; Display "Az: XXX.XXX°"
        ; ... send to display or serial ...

        RET

        END
